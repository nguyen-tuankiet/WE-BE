{
  "name": "we-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:demo": "tsx scripts/dev-pglite.ts",
    "build":"tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "check-compat": "tsx scripts/check-compat.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
