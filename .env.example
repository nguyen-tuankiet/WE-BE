# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# Chuỗi kết nối PostgreSQL (Neon: Dashboard > Connect > chọn khu vực Singapore). Cần sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cổng chạy server
PORT=3000
NODE_ENV=development

# Mã dùng MỘT LẦN để tạo Admin đầu tiên (>= 16 ký tự). Tạo xong nên xóa dòng này.
BOOTSTRAP_SECRET=

# Địa chỉ giao diện được phép gọi API, cách nhau bằng dấu phẩy. Ví dụ: https://we-fe.example.com,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Lax khi giao diện và API cùng miền; None (kèm HTTPS) khi khác miền.
COOKIE_SAMESITE=Lax
SESSION_DAYS=30
LOGIN_MAX_FAILS=5
LOGIN_WINDOW_MINUTES=15
